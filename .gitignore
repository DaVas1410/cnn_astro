# Docs and thesis writing (author's own material, stays local, never committed/pushed)
# turbulens/ is the package's own Sphinx docs and stays public/tracked.
/docs/*
!/docs/turbulens/
/paper/

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg
*.egg-info/
dist/
build/
.eggs/
*.so

# Sphinx documentation build output
docs/turbulens/_build/

# Environments
.env
.venv
env/
venv/
ENV/

# Jupyter
.ipynb_checkpoints/
*.ipynb_checkpoints

# Data files (large binaries)
data/raw/*.h5
data/raw/perf/

# Model checkpoints
*.pt
*.pth
*.ckpt
*.h5
*.keras

# NumPy arrays
*.npy
*.npz

# Figures / outputs (keep directory structure)
outputs/**/*.png
outputs/**/*.pdf
outputs/**/*.svg
outputs/output_data_*.npy

